# Server
NODE_ENV=development
PORT=5000

# MongoDB (required) - use MongoDB Atlas in production
MONGODB_URI=mongodb://localhost:27017/landmgmt

# Auth - generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay - set DEMO_MODE=true to mock payments (default: false)
DEMO_MODE=true
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Vercel Blob (optional) - persistent, CDN-backed image storage when deployed to Vercel
BLOB_READ_WRITE_TOKEN=
